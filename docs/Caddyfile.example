# Snippet for the host reverse-proxy stack (network `proxy`).
# Copy into the proxy Caddyfile and set env overrides as needed.

{$RRS37_HOST:rrs37b.mewes-im-netz.de} {
	encode zstd gzip

	handle {
		# Next.js streaming — avoid buffering
		reverse_proxy {$RRS37_UPSTREAM:rrs37-dashboard:3000} {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
