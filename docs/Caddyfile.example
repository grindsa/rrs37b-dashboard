# Example Caddy site for https://rrs37b.mewes-im-netz.de
# Use when Caddy runs in Docker on the same host and is attached to network `rss37`.
# Caddy obtains and renews TLS automatically when DNS points here.
#
# Prerequisites:
# - App container `rrs37-dashboard` on network `rss37` (see docker-compose.yml)
# - This Caddy container also joined to `rss37`

rrs37b.mewes-im-netz.de {
	encode gzip
	reverse_proxy rrs37-dashboard:3000 {
		# Pass through streaming responses without buffering
		flush_interval -1
	}
}
