# Snippet for the host reverse-proxy stack (network `proxy`).
# Copy into the proxy Caddyfile and set env overrides as needed.
#
# CSP, X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy are
# set by the app itself (next.config.ts), so only HSTS lives here.

{$RRS37_HOST:rrs37b.mewes-im-netz.de} {
	encode zstd gzip

	handle {
		# Next.js streaming — avoid buffering
		reverse_proxy {$RRS37_UPSTREAM:rrs37-dashboard:3000} {
			flush_interval -1
		}
	}

	header {
		# No `preload`: it only applies to apex domains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
