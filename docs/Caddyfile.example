# Snippet for the host reverse-proxy stack (network `proxy`).
# Copy into the proxy Caddyfile and set env overrides as needed.
#
# CSP, X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy are
# set by the app itself (next.config.ts), so only HSTS lives here.

{$RRS37_HOST:rrs37b.mewes-im-netz.de} {
	encode zstd gzip

	# The app only accepts small JSON bodies.
	request_body {
		max_size 16KB
	}

	handle {
		# Next.js streaming — avoid buffering
		reverse_proxy {$RRS37_UPSTREAM:rrs37b-dashboard:3000} {
			flush_interval -1
			# Caddy passes client-sent X-Real-IP through; overwrite it so the
			# login rate limit cannot be bypassed with a spoofed value.
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		# No `preload`: it only applies to apex domains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
