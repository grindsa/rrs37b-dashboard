# Optional — set automatically by deploy.sh / Dockerfile (YYYY-MM-DD-HH-MM-SS)
# BUILD_TIME=

# Auth — shared access tokens (comma-separated, max ~5). No user DB / OAuth.
# AUTH_SECRET signs the HttpOnly session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Each token at least 24 characters (shorter ones are ignored). openssl rand -hex 16
ACCESS_TOKENS=token1,token2
# Change to any new value to log out every device (sessions last 14 days since last use).
# SESSION_EPOCH=1

# Shelly devices (covers, plugs, BLE gateways, BLU sensors, Pro 3EM) live in
# YAML, not .env:
#   cp config/smarthome.example.yml config/smarthome.yml
# Fallback RPC password for devices without `password` in the YAML.
SHELLY_RPC_PASSWORD=
# Optional path override (default: config/smarthome.yml):
# SMARTHOME_CONFIG_FILE=config/smarthome.yml

# Weather — set once via geocoding for your address
OPEN_METEO_LAT=52.520008
OPEN_METEO_LON=13.404954

# BVG — v6.bvg.transport.rest
# STOP_1 + STOP_2 = default two-column "Zuhause" view.
# STOP_3+ appear in the BVG tab picker (one stop at a time).
# "Aktuelle Position" uses browser GPS, then OPEN_METEO_LAT/LON as fallback.
BVG_STOP_1_ID=900000000
BVG_STOP_1_NAME=Example Stop 1
BVG_STOP_2_ID=900000001
BVG_STOP_2_NAME=Example Stop 2
# BVG_STOP_3_ID=900000002
# BVG_STOP_3_NAME=Example Stop 3
# BVG_STOP_4_ID=900000003
# BVG_STOP_4_NAME=Example Stop 4
BVG_DURATION_MIN=30

# --- Photovoltaik -----------------------------------------------------------
# Shelly Pro 3EM (house consumption) is configured under `meters` in
# config/smarthome.yml.

# APsystems EZ1-M Local API (solar production = p1 + p2, W)
# Enable Local Mode → Continuously in AP EasyPower first (see README).
# APSYSTEMS_EZ1_HOST=192.168.0.30
# APSYSTEMS_EZ1_PORT=8050

# Growatt NOAH 2000 via noah-mqtt + Mosquitto (Compose profile `noah`)
# GROWATT_USERNAME / GROWATT_PASSWORD go into .env.noah (see .env.noah.example),
# never into this file — deploy.sh refuses to deploy if they are here.
# Prefer web API for read-only SoC (avoids App API IP bans):
# GROWATT_API_MODE=web
#
# Dashboard MQTT consumer (defaults to in-compose mosquitto when profile is on):
# NOAH_MQTT_URL=mqtt://mosquitto:1883
# Subscribe to all devices, or pin a serial: noah2mqtt/0ABC00AA15AA00AA
# NOAH_MQTT_TOPIC=noah2mqtt/+
# NOAH_MQTT_USERNAME=
# NOAH_MQTT_PASSWORD=
