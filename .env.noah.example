# Growatt account for the noah-mqtt sidecar (Compose profile `noah`).
# Only the noah-mqtt container reads this file; the dashboard never sees it.
#   cp .env.noah.example .env.noah && chmod 600 .env.noah
# deploy.sh enables the profile when GROWATT_USERNAME is set here.
GROWATT_USERNAME=
GROWATT_PASSWORD=
# Broker password for the read/write `noah` account (16+ chars, [A-Za-z0-9._~+=-]),
# e.g. openssl rand -hex 24. Must differ from NOAH_MQTT_PASSWORD in .env.
MQTT_PASSWORD=
